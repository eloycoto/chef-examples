# memcached default config file
# Generated by Ansible

# Run memcached as a daemon
-d

# Log memcached's output to the following file
logfile {{ memcached_log_file }}

# Start with a cap of 64 megs of memory
-m {{ memcached_memory }}

# Default connection port is 11211
-p {{ memcached_port }}

# Run the daemon as this user
-u {{ memcached_user }}

# Specify which IP address to listen on
-l {{ memcached_listen_address }}

# Limit the number of simultaneous incoming connections
-c {{ memcached_max_connections }}

{% if memcached_enable_sasl %}
# Enable SASL authentication
-S
{% endif %}

# Additional custom options
{% if memcached_extra_options is defined %}
{{ memcached_extra_options }}
{% endif %}