# Redis configuration file
# Generated by Ansible

# General configuration
daemonize yes
pidfile /var/run/redis/redis-{{ redis_servers[0].port }}.pid
port {{ redis_servers[0].port }}
timeout 0
loglevel notice
logfile {{ redis_log_dir }}/redis-{{ redis_servers[0].port }}.log

# Memory management
maxmemory-policy allkeys-lru
maxmemory {{ ansible_memtotal_mb | int // 4 }}mb

# Persistence
dir {{ redis_data_dir }}
dbfilename dump-{{ redis_servers[0].port }}.rdb
save 900 1
save 300 10
save 60 10000

# Security
{% if redis_servers[0].requirepass %}
requirepass {{ redis_servers[0].requirepass }}
{% endif %}

# Network
bind 127.0.0.1
protected-mode yes

# Advanced config
tcp-keepalive 60
databases 16