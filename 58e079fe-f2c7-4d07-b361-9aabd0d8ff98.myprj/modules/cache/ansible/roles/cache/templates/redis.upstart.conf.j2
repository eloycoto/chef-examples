description "Redis Server {{ redis_port | default('6379') }}"

start on runlevel [2345]
stop on runlevel [016]

respawn
respawn limit 10 5

setuid redis
setgid redis

env REDIS_PORT={{ redis_port | default('6379') }}
env REDIS_CONF_FILE=/etc/redis/${REDIS_PORT}.conf

exec /usr/bin/redis-server ${REDIS_CONF_FILE}